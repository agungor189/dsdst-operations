# Public-service listeners are hard-bound to 127.0.0.1 in Compose and consumed by Cloudflare on the same host.
PANEL_PORT=3000
WAREHOUSE_PORT=3006
KIT_STUDIO_PORT=3012
LABEL_PRINTER_PORT=3013
CUSTOMER_HUB_PORT=3100

# Source directories used by local builds. Production may override the image tags below.
PANEL_CONTEXT=../panel-kit-yonetimi
WAREHOUSE_CONTEXT=../Dsdst-Warehouse
KIT_STUDIO_CONTEXT=../dsdst-kit-studio
LABEL_PRINTER_CONTEXT=../Label-Printer
CUSTOMER_HUB_CONTEXT=../dsdst-customer-hub
PANEL_IMAGE=ghcr.io/OWNER/panel-kit-yonetimi:latest
WAREHOUSE_IMAGE=ghcr.io/OWNER/dsdst-warehouse:latest
KIT_STUDIO_IMAGE=ghcr.io/OWNER/dsdst-kit-studio:latest
LABEL_PRINTER_IMAGE=ghcr.io/OWNER/label-printer:latest
CUSTOMER_HUB_IMAGE=ghcr.io/OWNER/dsdst-customer-hub:latest

# Required secrets. Generate independently; never reuse values.
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
PANEL_API_HASH_SECRET=replace-with-at-least-32-random-characters
WAREHOUSE_API_KEY=replace-with-panel-issued-api-key
KIT_STUDIO_API_KEY=replace-with-panel-issued-api-key
LABEL_PRINTER_API_KEY=replace-with-panel-issued-api-key
CUSTOMER_HUB_API_KEY=replace-with-panel-issued-api-key
LABEL_RENDERER_API_KEY=replace-with-at-least-32-random-characters
# Exactly 64 hexadecimal characters (32 bytes), generated independently.
CUSTOMER_HUB_ENCRYPTION_KEY=replace-with-64-hex-characters

# Browser/reverse-proxy settings
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
PANEL_ALLOWED_ORIGINS=https://panel.example.com
KIT_STUDIO_ALLOWED_ORIGINS=https://kit.example.com
APP_URL=https://panel.example.com
CUSTOMER_HUB_APP_ORIGIN=https://customer-hub.example.com
CUSTOMER_HUB_SESSION_SECURE=true

# Printing. Keep dry-run false only on a host that is intentionally connected to CUPS.
WAREHOUSE_PRINTER_NAME=
WAREHOUSE_PRINT_DRY_RUN=true
CUPS_SERVER=

# Optional host bind mounts. Named volumes are used when left empty.
PANEL_DATA_DIR=panel_data
PANEL_UPLOADS_DIR=panel_uploads
PANEL_BACKUP_DIR=./backups/panel
KIT_STUDIO_DATA_DIR=kit_studio_data
KIT_STUDIO_UPLOADS_DIR=kit_studio_uploads
LABEL_PRINTER_DATA_DIR=label_printer_data
CUSTOMER_HUB_DATA_DIR=customer_hub_data
CUSTOMER_HUB_BACKUP_DIR=./backups/customer-hub
OPERATIONS_BACKUP_DIR=./backups

# Customer Hub provider configuration. Leave optional providers blank until configured.
CUSTOMER_HUB_META_APP_SECRET=
CUSTOMER_HUB_META_WEBHOOK_VERIFY_TOKEN=
CUSTOMER_HUB_ALLOWED_REMOTE_ATTACHMENT_HOSTS=
CUSTOMER_HUB_VERSION=latest
CUSTOMER_HUB_COMMIT=unknown

# Optional Panel cloud backup configuration
CLOUD_BACKUP_ENABLED=false
CLOUD_BACKUP_PROVIDER=cloudflare-r2
CLOUD_BACKUP_RCLONE_REMOTE=
CLOUD_BACKUP_PREFIX=production
CLOUD_BACKUP_RETENTION_DAYS=30
CLOUD_BACKUP_TIMEOUT_SECONDS=900
RECOVERY_OFFSITE_ENABLED=false
RECOVERY_OFFSITE_RCLONE_REMOTE=
RECOVERY_OFFSITE_PREFIX=production/recovery-points
RECOVERY_ENCRYPTION_PASSPHRASE=
RECOVERY_MANIFEST_HMAC_KEY=
RECOVERY_MANIFEST_HMAC_KEY_ID=external-v1
RCLONE_CONFIG_DSDSTR2_TYPE=
RCLONE_CONFIG_DSDSTR2_PROVIDER=
RCLONE_CONFIG_DSDSTR2_ACCESS_KEY_ID=
RCLONE_CONFIG_DSDSTR2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_DSDSTR2_ENDPOINT=

# Geliver carrier integration
GELIVER_TOKEN=
GELIVER_SENDER_ADDRESS_ID=
GELIVER_SOURCE_IDENTIFIER=
GELIVER_MODE=test
