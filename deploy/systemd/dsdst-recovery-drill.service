[Unit]
Description=DSDST monthly isolated restore drill
After=docker.service

[Service]
Type=oneshot
User=dsdst-operations
Group=dsdst-operations
WorkingDirectory=/opt/dsdst-operations
EnvironmentFile=/etc/dsdst/operations.env
ExecStart=/opt/dsdst-operations/scripts/restore-drill.sh
PrivateTmp=true
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
